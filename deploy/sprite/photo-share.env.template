# Settings for the photo wall on a Sprite. Lives at /home/sprite/photo-share/photo-share.env.
# After editing: sprite exec -- sprite-env services restart photo-share

# Server and storage (no MinIO on a Sprite: photos go straight to its durable disk)
PORT=8080
STORAGE_BACKEND=fs
PHOTO_DIR=/home/sprite/photo-share/data/photos
SQLITE_PATH=/home/sprite/photo-share/data/photoshare.db
STATIC_DIR=/home/sprite/photo-share/app/dist

# The Sprite proxy puts the real client address here. X-Forwarded-For starts with whatever the client sent.
CLIENT_IP_HEADER=Sprite-Client-Ip

# Secrets (generated on first deploy)
DEVICE_SECRET=__DEVICE_SECRET__
HOST_PIN=__HOST_PIN__

# Defaults for NEW events (the host can change them per event in /admin), plus the title used when
# photos from the old single-event version are moved into an event on first start.
EVENT_TITLE="Graduation Wall 🎓"
EVENT_SUBTITLE="Scan the QR code to drop up to 5 favorite memories on the big screen!"
EVENT_CODE=
MAX_PHOTOS_PER_PERSON=5
MAX_PHOTOS_PER_IP=150
