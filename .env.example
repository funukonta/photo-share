# Copy to .env for docker compose or a local run. On a Sprite, deploy/sprite/deploy.sh writes its own env file.

# Server
PORT=8080
STATIC_DIR=./frontend/dist

# Photo storage: "fs" keeps photos on local disk (PHOTO_DIR); "minio" uses the MinIO settings below
STORAGE_BACKEND=minio
PHOTO_DIR=./data/photos

# MinIO (only for STORAGE_BACKEND=minio)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=photos
MINIO_USE_SSL=false

# SQLite metadata and runtime settings
SQLITE_PATH=./data/photoshare.db

# Secrets: generate real values before the event
#   DEVICE_SECRET: openssl rand -hex 32
DEVICE_SECRET=replace-with-openssl-rand-hex-32
HOST_PIN=replace-with-a-pin
EVENT_CODE=

# Header a trusted proxy sets with the real client IP. Leave empty when nothing sits in front of the app.
#   Sprites: Sprite-Client-Ip   Fly Machines: Fly-Client-IP   nginx: X-Real-IP
CLIENT_IP_HEADER=

# First-boot event defaults (change live in /admin afterwards)
EVENT_TITLE=Graduation Wall 🎓
EVENT_SUBTITLE=Scan the QR code to drop up to 5 favorite memories on the big screen!
MAX_PHOTOS_PER_PERSON=5
MAX_PHOTOS_PER_IP=150
